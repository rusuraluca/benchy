{
  "name": "benchy",
  "version": "0.1.0",
  "description": "Drop-in eval suite for LLM apps: define test cases, run against your app, score outputs, track regressions over time.",
  "type": "module",
  "license": "MIT",
  "author": "Raluca Rusu",
  "keywords": [
    "llm",
    "eval",
    "evaluation",
    "testing",
    "ai",
    "benchmark",
    "regression"
  ],
  "bin": {
    "benchy": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsup && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "demo:run": "node dist/cli/index.js run --config examples/demo/benchy.yaml --target http://localhost:3000"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.2.0",
    "minimist": "^1.2.8",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.4"
  }
}
