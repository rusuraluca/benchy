# The demo support-triage app used by examples/demo and the CI eval workflow.
FROM node:20-alpine
WORKDIR /app

COPY examples/demo-app/package.json examples/demo-app/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY examples/demo-app/tsconfig.json ./
COPY examples/demo-app/src ./src
RUN npm run build

ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=5s --timeout=2s --start-period=3s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/server.js"]